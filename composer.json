{
  "name": "minionfactory/raw-hydrator",
  "description": "Run a raw SQL query and hydrate Eloquent models (with relations) from the result set, in a single round trip.",
  "type": "library",
  "keywords": [
    "laravel",
    "eloquent",
    "raw",
    "hydrate",
    "query"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Paul Warren",
      "email": "paulwarren.php@gmail.com",
      "role": "Developer",
      "homepage": "https://paulwarren.ca"
    }
  ],
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "laravel/framework": "^10.0|^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "MinionFactory\\RawHydrator\\": "src/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
